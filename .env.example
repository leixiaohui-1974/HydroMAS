# HydroMAS Environment Configuration
# Copy to .env and fill in actual values

# ---------- Application ----------
ENV=development                       # development | production
ALLOWED_ORIGINS=http://localhost:8000  # Comma-separated CORS origins

# ---------- Feishu / 飞书 ----------
FEISHU_APP_ID=                         # Feishu app ID
FEISHU_APP_SECRET=                     # Feishu app secret
FEISHU_WEBHOOK_URL=                    # Bot webhook callback URL
FEISHU_ALERT_WEBHOOK_URL=              # Alert webhook URL (incoming)

# ---------- TDengine ----------
TDENGINE_HOST=tdengine                 # TDengine host (docker service name)
TDENGINE_PORT=6041                     # TDengine REST port

# ---------- Neo4j ----------
NEO4J_URI=bolt://neo4j:7687           # Neo4j bolt protocol URI
NEO4J_USER=neo4j                       # Neo4j username
NEO4J_PASSWORD=hydromas2024            # Neo4j password

# ---------- Ray ----------
RAY_ADDRESS=                           # Ray cluster address (empty = local)
