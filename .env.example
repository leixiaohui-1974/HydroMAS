# HydroClaw — 水网智能工作台 环境变量配置
# Copy to .env and fill in actual values
# 复制为 .env 并填写实际值

# ---------- Application / 应用 ----------
ENV=development                       # development | production
ALLOWED_ORIGINS=http://localhost:8000  # Comma-separated CORS origins
HYDROMAS_API_KEY=                      # API key for authentication (empty = no auth)

# ---------- Feishu / 飞书 ----------
FEISHU_APP_ID=cli_a915cc56d5f89cb1    # Feishu app ID
FEISHU_APP_SECRET=                     # Feishu app secret
FEISHU_WEBHOOK_URL=                    # Bot webhook callback URL
FEISHU_ALERT_WEBHOOK_URL=              # Alert webhook URL (incoming)

# ---------- TDengine ----------
TDENGINE_HOST=tdengine                 # TDengine host (docker service name)
TDENGINE_PORT=6041                     # TDengine REST port

# ---------- Neo4j ----------
NEO4J_URI=bolt://neo4j:7687           # Neo4j bolt protocol URI
NEO4J_USER=neo4j                       # Neo4j username
NEO4J_PASSWORD=hydromas2024            # Neo4j password

# ---------- Ray ----------
RAY_ADDRESS=                           # Ray cluster address (empty = local)

# ---------- HydroClaw / 水网智能工作台 ----------
HYDROCLAW_SESSION_SCOPE=per-user       # per-user | per-group | main
HYDROCLAW_PERSONALITY_DIR=             # Personality files dir (default: data/personality)
HYDROCLAW_MEMORY_DIR=                  # Memory files dir (default: data/memory)
HYDROCLAW_SESSION_DIR=                 # Session files dir (default: data/sessions)
HYDROCLAW_INTERACTION_DIR=             # Interaction logs dir (default: data/interactions)

# ---------- OpenClaw Instances (Phase 2+) ----------
ANTHROPIC_API_KEY=                     # For OpenClaw instances
OPENCLAW_MODEL=claude-sonnet-4-5-20250929

# ---------- Self-Evolution / 自进化 ----------
EVOLVE_DAYS_BACK=7                     # Days to analyze for evolution
