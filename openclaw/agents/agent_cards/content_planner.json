{
  "agent_id": "content_planner",
  "name": "ContentPlannerAgent",
  "display_name": "内容规划Agent / Content Planner",
  "description": "Analyses content requirements and generates production plans with outlines, image plans, and publish schedules.",
  "capabilities": [
    "requirement_analysis",
    "content_type_detection",
    "audience_targeting",
    "outline_generation",
    "image_planning",
    "channel_selection"
  ],
  "input_protocol": {
    "type": "text",
    "format": "free_text_requirement"
  },
  "output_protocol": {
    "type": "ContentPlan",
    "fields": ["plan_id", "requirement", "writing_outline", "image_plan", "publish_channels"]
  },
  "layer": "L4",
  "version": "1.0.0"
}
