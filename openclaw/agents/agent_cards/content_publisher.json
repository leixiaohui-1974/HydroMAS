{
  "agent_id": "content_publisher",
  "name": "ContentPublisherAgent",
  "display_name": "内容发布Agent / Content Publisher",
  "description": "Multi-channel content publishing: Feishu images, WeChat articles, video generation, PPT export.",
  "capabilities": [
    "publish_planning",
    "feishu_publish",
    "wechat_publish",
    "video_generation",
    "config_validation"
  ],
  "input_protocol": {
    "type": "config",
    "format": "channel_config_dict"
  },
  "output_protocol": {
    "type": "PublishResult",
    "fields": ["channel", "success", "url", "file_path", "details"]
  },
  "layer": "L4",
  "version": "1.0.0"
}
